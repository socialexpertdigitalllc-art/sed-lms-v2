NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Tools (Phase 4) — server-side only, never exposed to the client
# Kimi / Moonshot — powers the WebCraft generator. https://platform.moonshot.ai
KIMI_API_KEY=
# DeepSeek — powers the DeepSeek generator. https://platform.deepseek.com
DEEPSEEK_API_KEY=

# WGE-2 automation
WGE_PROCESSOR_SECRET=
WGE_SELF_ORIGIN=http://localhost:3000

# Phase 5 — Google Sheets importer (service account JSON, one line). Reused from the legacy app.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Company mailbox linking (Sub-project 1) — 32-byte base64 key for AES-256-GCM
# encryption of stored IMAP/SMTP passwords. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAILBOX_ENC_KEY=

# Google OAuth (Drive + Docs) for contract templates
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://<app-host>/api/admin/google/callback

# Shared secret for the cron mail poller (/api/mail/poll). Sent as the
# `x-mail-poll-secret` header; if unset, the endpoint rejects every request.
MAIL_POLL_SECRET=

# Email verification providers. These are only a ONE-TIME SEED for the
# `email_verify_providers` DB row — the settings UI is authoritative afterwards.
VERIFALIA_USERNAME=
VERIFALIA_PASSWORD=
REOON_API_KEY=
MAILROOK_API_KEY=
INBOXTRUE_API_KEY=
CHECK_MAIL_API_KEY=
