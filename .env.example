NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Tools (Phase 4) — server-side only, never exposed to the client
# Kimi / Moonshot — powers the WebCraft generator. https://platform.moonshot.ai
KIMI_API_KEY=
# DeepSeek — powers the DeepSeek generator. https://platform.deepseek.com
DEEPSEEK_API_KEY=

# WGE-2 automation
WGE_PROCESSOR_SECRET=
WGE_SELF_ORIGIN=http://localhost:3000

# Phase 5 — Google Sheets importer (service account JSON, one line). Reused from the legacy app.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Company mailbox linking (Sub-project 1) — 32-byte base64 key for AES-256-GCM
# encryption of stored IMAP/SMTP passwords. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAILBOX_ENC_KEY=

# Google OAuth (Drive + Docs) for contract templates
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://<app-host>/api/admin/google/callback

# Shared secret for the cron mail poller (/api/mail/poll). Sent as the
# `x-mail-poll-secret` header; if unset, the endpoint rejects every request.
MAIL_POLL_SECRET=

# Email verification providers. These are only a ONE-TIME SEED for the
# `email_verify_providers` DB row — the settings UI is authoritative afterwards.
VERIFALIA_USERNAME=
VERIFALIA_PASSWORD=
REOON_API_KEY=
MAILROOK_API_KEY=
INBOXTRUE_API_KEY=
CHECK_MAIL_API_KEY=

# Form Relay: the public URL client sites POST to. Shown in the Integration
# card and baked into snippets. Defaults to the production LMS origin.
FORM_RELAY_PUBLIC_URL=https://lms.sedsolutions.online/api/forms/submit

# SED AI on the phone (Telegram / WhatsApp). Setup: docs/assistant-phone-channel.md.
# People can link a channel (Actions → Reminders & automations → Phone) only
# when ALL of its variables are set. Server-side only — never NEXT_PUBLIC_.
#
# The public https address people open the app at (no trailing slash): links in
# phone replies are built on it. Falls back to WGE_SELF_ORIGIN when unset.
APP_PUBLIC_URL=
# Telegram: the token @BotFather gives you, the bot's username (without the @),
# and a random secret you pass to setWebhook as secret_token (1-256 characters,
# A-Z a-z 0-9 _ -). Telegram sends it back on every webhook call.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Cloud API (Meta): a permanent system-user access token, the sending
# number's Phone number ID, the Meta app's App secret (it signs every webhook),
# a verify token you make up for Meta's webhook check, and the number as people
# should type it (e.g. +92 300 1234567).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DISPLAY_NUMBER=

# AI logo generator (lead page). Optional company-wide cap on pictures per
# UTC day; unset = no cap of our own (the MiniMax plan is the limit).
# LOGO_DAILY_IMAGE_BUDGET=
# Which logo designer is the default: minimax (symbol + typeset name) or google
# (complete logos, Nano Banana Pro, billed per picture to the Gemini API key's
# project). Unset = MiniMax when it is set up; Google is one click away.
# LOGO_IMAGE_ENGINE=
